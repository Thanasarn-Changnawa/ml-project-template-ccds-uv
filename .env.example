# Example environment variables for ML project
# Copy this file to .env and update with your values

# Python settings
PYTHONPATH=.

# PyTorch settings
CUDA_VISIBLE_DEVICES=0

# Paths
DATA_DIR=./data
MODEL_DIR=./models
LOG_DIR=./logs

# Training parameters
BATCH_SIZE=32
LEARNING_RATE=0.001
NUM_EPOCHS=10

# Experiment tracking (optional)
# WANDB_API_KEY=your_key_here
# MLFLOW_TRACKING_URI=http://localhost:5000
